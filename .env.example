# Airtable Personal Access Token（唯讀即可）
# 到 https://airtable.com/create/tokens 建立：
#   scope：data.records:read + schema.bases:read
#   access：加入兩個 base（civic tech project database、公民科學與群眾參與計畫清冊資料集）
# 複製本檔為 .env 後填入（.env 已被 gitignore，不會進版控）
AIRTABLE_PAT=patXXXXXXXXXXXXXX

# 寫回 Airtable 用（scripts/apply-edit.mjs，實驗中）。跟上面那把分開，唯讀那把外流的代價比較小
#   scope：data.records:read + data.records:write + schema.bases:read
#   access：只加需要寫入的 base
AIRTABLE_WRITE_PAT=patXXXXXXXXXXXXXX
